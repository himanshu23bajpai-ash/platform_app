# Base URL for API calls (Vite proxies /api → http://localhost:8000 in dev).
VITE_API_BASE=/api

# Azure AD SSO (MSAL) — leave blank to disable and use the server-side
# OAuth flow (or AUTH_DISABLED=true) instead.
VITE_AZURE_TENANT_ID=
VITE_AZURE_CLIENT_ID=
# Defaults to window.location.origin if not set.
VITE_AZURE_REDIRECT_URI=
