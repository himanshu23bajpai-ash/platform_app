# Database
DATABASE_URL=sqlite:///./platform.db

# CORS
FRONTEND_ORIGIN=http://localhost:5173

# Session
SESSION_SECRET=change-me-in-prod

# Azure AD
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_REDIRECT_URI=http://localhost:8000/auth/callback
AZURE_POST_LOGIN_REDIRECT=http://localhost:5173/projects

# AWS: auto | real | mock
AWS_MODE=auto
AWS_REGION=us-east-1

# Dev: skip auth (for local testing without Azure AD configured)
AUTH_DISABLED=true

# Simulate failure on a given onboarding step (REPO_REGISTRATION|AWS_ACCOUNT_VPC|CICD_PIPELINE|COMPUTE_PROVISION)
SIMULATE_FAIL_STEP=
